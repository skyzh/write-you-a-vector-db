query T
EXPLAIN SELECT id, payload FROM points
ORDER BY array_distance(embedding, [1.0, 1.0, 1.0]) LIMIT 5;
----
SortExec: TopK(fetch=5), expr=[array_distance(CAST(embedding@2 AS List(Float64)), [1.0, 1.0, 1.0]) ASC NULLS LAST], preserve_partitioning=[false]
DataSourceExec: partitions=1, partition_sizes=[1]

statement ok
CREATE INDEX arbitrary_hnsw_name ON points USING hnsw (embedding);

query T
EXPLAIN SELECT id, payload FROM points
ORDER BY array_distance(embedding, [1.0, 1.0, 1.0]) LIMIT 5;
