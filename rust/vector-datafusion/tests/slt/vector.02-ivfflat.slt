query T
EXPLAIN SELECT id, payload FROM points
ORDER BY array_distance(embedding, [1.0, 1.0, 1.0]) LIMIT 5;
----
SortExec: TopK(fetch=5), expr=[array_distance(CAST(embedding@2 AS List(non-null Float64)), [1.0, 1.0, 1.0]) ASC NULLS LAST], preserve_partitioning=[false]
VectorIndexScanExec: index=ivf_flat, metric=Euclidean, query_dim=3, fetch=Some(5), ordered=false

